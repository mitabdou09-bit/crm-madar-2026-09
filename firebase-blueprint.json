{
  "entities": {
    "TeamMember": {
      "title": "TeamMember",
      "description": "Authorized team member registered in the equipment dashboard using the workspace access code.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128,
          "description": "Firebase Auth UID of the team member."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Display name shown on team edits and notes."
        },
        "role": {
          "type": "string",
          "enum": ["member"],
          "description": "Standard team member role; admin elevation is never self-assigned here."
        },
        "accessCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "description": "Workspace entry verification code."
        },
        "joinedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the member joined."
        }
      },
      "required": ["uid", "displayName", "role", "accessCode", "joinedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Admin privilege record allowing equipment deletion and backup restoration.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "grantedBy": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "grantedBy", "grantedAt"]
    },
    "AdminEmailRecord": {
      "title": "AdminEmailRecord",
      "description": "Email-indexed admin privilege record allowing equipment deletion and backup restoration.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "pattern": "^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$",
          "minLength": 3,
          "maxLength": 160
        },
        "grantedBy": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "grantedByEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160
        },
        "grantedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "grantedBy", "grantedByEmail", "grantedAt"]
    },
    "Equipment": {
      "title": "Equipment",
      "description": "Tracked equipment record with status and workshop exit delay details.",
      "type": "object",
      "properties": {
        "workspaceKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "equipmentNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "enum": [
            "آليات ثقيلة",
            "رافعات",
            "مولدات كهربائية",
            "ضواغط هواء",
            "معدات لحام",
            "سيارات خدمة",
            "أجهزة قياس",
            "أخرى"
          ]
        },
        "condition": {
          "type": "string",
          "enum": [
            "جاهزة للعمل",
            "قيد الصيانة",
            "متوقفة - بانتظار",
            "خارجة عن الخدمة"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "entryDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "maxLength": 10
        },
        "expectedExitDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "maxLength": 10
        },
        "delayServices": {
          "type": "boolean"
        },
        "delayServicesNote": {
          "type": "string",
          "maxLength": 1500
        },
        "delaySpareParts": {
          "type": "boolean"
        },
        "delaySparePartsNote": {
          "type": "string",
          "maxLength": 1500
        },
        "delayOther": {
          "type": "boolean"
        },
        "delayOtherNote": {
          "type": "string",
          "maxLength": 1500
        },
        "finalExitDate": {
          "type": "string",
          "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$",
          "maxLength": 10,
          "description": "Actual final exit date from the maintenance workshop (YYYY-MM-DD or empty)."
        },
        "createdByUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "lastUpdatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "workspaceKey",
        "name",
        "equipmentNumber",
        "category",
        "condition",
        "location",
        "entryDate",
        "expectedExitDate",
        "delayServices",
        "delayServicesNote",
        "delaySpareParts",
        "delaySparePartsNote",
        "delayOther",
        "delayOtherNote",
        "createdByUid",
        "createdBy",
        "lastUpdatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "EquipmentNote": {
      "title": "EquipmentNote",
      "description": "Team collaboration note attached to a specific equipment document.",
      "type": "object",
      "properties": {
        "workspaceKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "equipmentId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "authorUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": ["member", "admin"]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "workspaceKey",
        "equipmentId",
        "authorUid",
        "author",
        "role",
        "text",
        "createdAt"
      ]
    },
    "CloudBackup": {
      "title": "CloudBackup",
      "description": "Cloud snapshot backup of equipment items.",
      "type": "object",
      "properties": {
        "workspaceKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "createdByUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "itemCount": {
          "type": "number"
        },
        "items": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "workspaceKey",
        "label",
        "createdByUid",
        "createdBy",
        "itemCount",
        "items",
        "createdAt"
      ]
    },
    "OrgAsset": {
      "title": "OrgAsset",
      "description": "Organization-wide equipment inventory item recording name, number, and status.",
      "type": "object",
      "properties": {
        "workspaceKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "assetNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "status": {
          "type": "string",
          "enum": [
            "يعمل - حالة جيدة",
            "بحاجة لصيانة",
            "معطل",
            "خارج الخدمة"
          ]
        },
        "createdByUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "minLength": 1,
          "maxLength": 128
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "lastUpdatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "workspaceKey",
        "name",
        "assetNumber",
        "status",
        "createdByUid",
        "createdBy",
        "lastUpdatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "LocalSyncEquipment": {
      "title": "LocalSyncEquipment",
      "description": "Shared colleague sync equipment record used by Crm Local Desktop Edition (two-way merge with localStorage).",
      "type": "object",
      "properties": {
        "workspaceKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "equipmentNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "category": {
          "type": "string",
          "enum": [
            "آليات ثقيلة",
            "رافعات",
            "مولدات كهربائية",
            "ضواغط هواء",
            "معدات لحام",
            "سيارات خدمة",
            "أجهزة قياس",
            "أخرى"
          ]
        },
        "condition": {
          "type": "string",
          "enum": [
            "جاهزة للعمل",
            "قيد الصيانة",
            "متوقفة - بانتظار",
            "خارجة عن الخدمة"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "entryDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "maxLength": 10
        },
        "expectedExitDate": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "maxLength": 10
        },
        "delayServices": { "type": "boolean" },
        "delayServicesNote": { "type": "string", "maxLength": 1500 },
        "delaySpareParts": { "type": "boolean" },
        "delaySparePartsNote": { "type": "string", "maxLength": 1500 },
        "delayOther": { "type": "boolean" },
        "delayOtherNote": { "type": "string", "maxLength": 1500 },
        "finalExitDate": {
          "type": "string",
          "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$",
          "maxLength": 10
        },
        "teamNotes": { "type": "array" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 80 },
        "lastUpdatedBy": { "type": "string", "minLength": 1, "maxLength": 80 },
        "createdAtIso": { "type": "string", "minLength": 10, "maxLength": 40 },
        "updatedAtIso": { "type": "string", "minLength": 10, "maxLength": 40 },
        "deleted": { "type": "boolean" },
        "syncedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "workspaceKey",
        "name",
        "equipmentNumber",
        "category",
        "condition",
        "location",
        "entryDate",
        "expectedExitDate",
        "delayServices",
        "delayServicesNote",
        "delaySpareParts",
        "delaySparePartsNote",
        "delayOther",
        "delayOtherNote",
        "teamNotes",
        "createdBy",
        "lastUpdatedBy",
        "createdAtIso",
        "updatedAtIso",
        "deleted",
        "syncedAt"
      ]
    },
    "LocalSyncOrgAsset": {
      "title": "LocalSyncOrgAsset",
      "description": "Shared colleague sync organization inventory record used by Crm Local Desktop Edition.",
      "type": "object",
      "properties": {
        "workspaceKey": { "type": "string", "minLength": 1, "maxLength": 32 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "assetNumber": { "type": "string", "minLength": 1, "maxLength": 80 },
        "status": {
          "type": "string",
          "enum": [
            "يعمل - حالة جيدة",
            "بحاجة لصيانة",
            "معطل",
            "خارج الخدمة"
          ]
        },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 80 },
        "lastUpdatedBy": { "type": "string", "minLength": 1, "maxLength": 80 },
        "createdAtIso": { "type": "string", "minLength": 10, "maxLength": 40 },
        "updatedAtIso": { "type": "string", "minLength": 10, "maxLength": 40 },
        "deleted": { "type": "boolean" },
        "syncedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "workspaceKey",
        "name",
        "assetNumber",
        "status",
        "createdBy",
        "lastUpdatedBy",
        "createdAtIso",
        "updatedAtIso",
        "deleted",
        "syncedAt"
      ]
    },
    "WorkspaceSettings": {
      "title": "WorkspaceSettings",
      "description": "Global workspace controls managed exclusively by the Primary Admin, including Sync & Refresh Lock.",
      "type": "object",
      "properties": {
        "workspaceKey": { "type": "string", "minLength": 1, "maxLength": 32 },
        "syncRefreshLocked": { "type": "boolean" },
        "lockReason": { "type": "string", "maxLength": 300 },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 80 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["workspaceKey", "syncRefreshLocked", "lockReason", "updatedBy", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable activity and modification audit trail visible exclusively to the Primary Admin across Cloud, Local, and Transfer actions.",
      "type": "object",
      "properties": {
        "workspaceKey": { "type": "string", "minLength": 1, "maxLength": 32 },
        "sourceMode": { "type": "string", "enum": ["cloud", "local", "transfer", "admin"] },
        "action": {
          "type": "string",
          "enum": [
            "create",
            "update",
            "delete",
            "note",
            "sync",
            "transfer_to_cloud",
            "transfer_to_local",
            "lock_toggle",
            "permission_change",
            "backup_restore"
          ]
        },
        "entityType": {
          "type": "string",
          "enum": ["equipment", "orgAsset", "note", "backup", "team", "settings"]
        },
        "entityId": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "minLength": 1, "maxLength": 128 },
        "entityLabel": { "type": "string", "minLength": 1, "maxLength": 200 },
        "details": { "type": "string", "maxLength": 400 },
        "actorUid": { "type": "string", "pattern": "^[a-zA-Z0-9_\\-]+$", "minLength": 1, "maxLength": 128 },
        "actorName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "workspaceKey",
        "sourceMode",
        "action",
        "entityType",
        "entityId",
        "entityLabel",
        "details",
        "actorUid",
        "actorName",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/teamMembers/{userId}": {
      "schema": { "$ref": "#/entities/TeamMember" },
      "description": "Stores verified team members who unlocked the workspace with the access code."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Stores admin UIDs authorized to delete equipment and restore backups."
    },
    "/adminEmails/{emailId}": {
      "schema": { "$ref": "#/entities/AdminEmailRecord" },
      "description": "Stores normalized lowercase admin emails authorized to delete records and restore backups."
    },
    "/equipment/{equipmentId}": {
      "schema": { "$ref": "#/entities/Equipment" },
      "description": "Main equipment tracking collection synchronized in real time across the team."
    },
    "/equipment/{equipmentId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/EquipmentNote" },
      "description": "Subcollection of team notes on each equipment record."
    },
    "/backups/{backupId}": {
      "schema": { "$ref": "#/entities/CloudBackup" },
      "description": "Cloud backup snapshots for point-in-time recovery."
    },
    "/orgAssets/{assetId}": {
      "schema": { "$ref": "#/entities/OrgAsset" },
      "description": "Organization equipment inventory list (name, number, status) with team edit/add and admin-only delete."
    },
    "/localSyncEquipment/{itemId}": {
      "schema": { "$ref": "#/entities/LocalSyncEquipment" },
      "description": "Shared colleague sync store for Crm Local Desktop Edition equipment and notes."
    },
    "/localSyncOrgAssets/{assetId}": {
      "schema": { "$ref": "#/entities/LocalSyncOrgAsset" },
      "description": "Shared colleague sync store for Crm Local Desktop Edition organization inventory."
    },
    "/workspaceSettings/{workspaceId}": {
      "schema": { "$ref": "#/entities/WorkspaceSettings" },
      "description": "Workspace-level sync and refresh lock controlled exclusively by the Primary Admin."
    },
    "/auditLogs/{logId}": {
      "schema": { "$ref": "#/entities/AuditLog" },
      "description": "Immutable audit log of modifications and transfers monitored by the Primary Admin."
    }
  }
}

